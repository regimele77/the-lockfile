# Django
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Public site URL (used in templates / context)
SITE_URL=https://thelockfile.com

# PostgreSQL
POSTGRES_DB=lockfile
POSTGRES_USER=lockfile
POSTGRES_PASSWORD=lockfile
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---------------------------------------------------------------------------
# Scan pipeline (worker + beat)
# Workspace is wiped after each scan. git must be installed in the image.
# ---------------------------------------------------------------------------
SCAN_WORKSPACE_ROOT=/tmp/lockfile-scans
SCAN_CLONE_TIMEOUT_SECONDS=300
SCAN_CLONE_DEPTH=1
SCAN_MAX_REPO_SIZE_MB=500
# Re-scan a tracked repo when its last finished scan is older than this.
SCAN_RESCHEDULE_HOURS=24
# How often Celery beat checks for due repos.
SCAN_SCHEDULE_CHECK_HOURS=1

# ---------------------------------------------------------------------------
# Scanners (Celery worker, after clone). All enabled by default.
# Heuristic rules can false-positive; review findings before acting.
# ---------------------------------------------------------------------------
SCANNER_ENABLE_SECRETS=1
SCANNER_ENABLE_DEPENDENCIES=1
SCANNER_ENABLE_CONFIGS=1
SCANNER_ENABLE_PRACTICES=1
SCANNER_ENABLE_WORKFLOWS=1
SCANNER_TIMEOUT_SECONDS=120
SCANNER_MAX_FINDINGS_PER_SCANNER=50
SCANNER_MAX_FILE_BYTES=512000
SCANNER_MAX_FILES=8000
# OSV.dev advisory lookup for dependency CVEs (needs outbound HTTPS).
SCANNER_OSV_ENABLED=1
SCANNER_OSV_TIMEOUT_SECONDS=30
SCANNER_OSV_MAX_PACKAGES=200
SCANNER_GITHUB_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# GitHub App (required for Connect with GitHub login + repo sync + clone)
# Create at: https://github.com/settings/apps/new
# Local callback / setup / webhook URLs must match what you enter on the App:
#   Callback URL:  http://localhost:8000/accounts/github/callback/
#   Setup URL:     http://localhost:8000/accounts/github/setup/
#   Webhook URL:   http://localhost:8000/accounts/github/webhook/
#                  (use a tunnel such as ngrok/cloudflared for GitHub to reach local Docker)
#
# Permission matrix (set under the App: Permissions & events):
#   Account -> Email addresses: Read-only          (login / user email)
#   Repository -> Metadata: Read-only              (list repos)
#   Repository -> Contents: Read-only              (clone for scans)
#   Repository -> Administration: Read-only        (practices: branch protection)
# After you change App permissions, each installation must Accept on GitHub.
#
# Subscribe to webhook events: installation, installation_repositories
# (ping is handled automatically). Empty GITHUB_APP_WEBHOOK_SECRET is only
# accepted when DJANGO_DEBUG=1; production always requires a secret + signature.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste PEM contents here; use \n for newlines. Or set GITHUB_APP_PRIVATE_KEY_PATH.
# Required to mint installation access tokens (~1 hour) for repo sync and clone.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# Used to verify X-Hub-Signature-256 on /accounts/github/webhook/
GITHUB_APP_WEBHOOK_SECRET=
# Public slug from https://github.com/apps/<slug> (used for install redirects)
GITHUB_APP_NAME=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/accounts/github/callback/
# Fernet key for encrypting user OAuth tokens (GitHubAccount.access_token) at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Backup this value; rotation requires re-connect (or a decrypt/re-encrypt migration).
# Required when DJANGO_DEBUG=0. In DEBUG without a key, tokens stay plaintext with a warning.
GITHUB_TOKEN_FERNET_KEY=
